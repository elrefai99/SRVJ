apiVersion: v1
kind: Secret
metadata:
  name: srvj-secret
  namespace: srvj
type: Opaque
stringData:
  PORT: "9000"
  NODE_ENV: "production"

  DATABASE_URL: "postgresql://user:password@host:5432/dbname?sslmode=require"
  MONGODB_URI: "mongodb+srv://user:password@cluster.mongodb.net/srvj"

  REDIS_CACHE_LIVE: "redis://srvj-redis-svc:6379"
  REDIS_CACHE_BULLMQ: "redis://srvj-redis-svc:6379"

  API_KEY_SALT: "12"
  GOOGLE_CLIENT_ID: ""

  EMAIL: ""
  SITE_URL_TEST: ""
  SITE_URL_LIVE: ""
  SITE_API_URL: ""
  API_LINK: ""

  CLOUDINARY_CLOUD_NAME: ""
  CLOUDINARY_API_KEY: ""
  CLOUDINARY_API_SECRET: ""

  LOG_LEVEL: "info"
  INVITE_TOKEN: ""

  ACCESS_PRIVATE_KEY: ""
  ACCESS_PUBLICE_KEY: ""
  REFRESH_PRIVATE_KEY: ""
  REFRESH_PUBLIC_KEY: ""
  PENDING_PRIVATE_KEY: ""
  PRIVATE_FORGET_PASSWORD_SECRET_KY: ""
