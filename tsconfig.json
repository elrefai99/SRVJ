{
  "extends": "@mohamed-elrefai/tsconfigs",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Bundler",
    "rootDir": "./",
    "outDir": "dist",
    "typeRoots": [
      "./src/types",
      "./node_modules/@types"
    ],
    "types": [
      "node",
      "express"
    ],
    "ignoreDeprecations": "5.0",
  }
}
