generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id      Int    @id @default(autoincrement())
  site_id String @unique @default(uuid())

  fullname String
  email    String  @unique
  username String? @unique

  password String?
  googleId String?

  avatar String?

  status tableStatus @default(active)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects              Project[]        @relation("ProjectOwner")
  collaborations        ProjectMember[]
  diagramVersions       DiagramVersion[]
  sentNotifications     Notification[]   @relation("NotificationFrom")
  receivedNotifications Notification[]   @relation("NotificationTo")

  @@index([email])
  @@index([username])
  @@index([createdAt])
  @@map("users")
}

model Project {
  id      Int    @id @default(autoincrement())
  site_id String @unique @default(uuid())

  title       String
  description String?

  visibility ProjectVisibility @default(PRIVATE)
  status     tableStatus       @default(active)

  ownerId Int
  owner   User @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  diagram    Diagram?
  members    ProjectMember[]
  shareLinks ShareLink[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([title])
  @@index([status])
  @@index([createdAt])
  @@map("projects")
}

model ProjectMember {
  id      Int    @id @default(autoincrement())
  site_id String @unique @default(uuid())

  projectId Int
  userId    Int

  role   ProjectRole @default(VIEWER)
  status tableStatus @default(active)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
  @@index([createdAt])
  @@map("project_members")
}

model Diagram {
  id      Int    @id @default(autoincrement())
  site_id String @unique @default(uuid())

  projectId Int     @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  version Int @default(1)

  nodes    Json
  edges    Json
  metadata Json?

  versions DiagramVersion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@map("diagrams")
}

model DiagramVersion {
  id      Int    @id @default(autoincrement())
  site_id String @unique @default(uuid())

  diagramId Int
  diagram   Diagram @relation(fields: [diagramId], references: [id], onDelete: Cascade)

  version Int

  nodes    Json
  edges    Json
  metadata Json?

  createdById Int?
  createdBy   User? @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([diagramId, version])
  @@index([diagramId])
  @@index([createdAt])
  @@map("diagram_versions")
}

model ShareLink {
  id      Int    @id @default(autoincrement())
  site_id String @unique @default(uuid())

  token String @unique

  projectId Int
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  role ProjectRole @default(VIEWER)

  expiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([createdAt])
  @@map("share_links")
}

model Notification {
  id         Int    @id @default(autoincrement())
  site_id    String @unique @default(uuid())
  fromUserId Int?
  toUserId   Int?

  title   String
  message String?

  isRead Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fromUser User? @relation("NotificationFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User? @relation("NotificationTo", fields: [toUserId], references: [id], onDelete: Cascade)

  @@index([toUserId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

enum tableStatus {
  active
  inactive
  delete
  ban
}

enum ProjectRole {
  OWNER
  EDITOR
  VIEWER
}

enum ProjectVisibility {
  PRIVATE
  PUBLIC
  UNLISTED
}
