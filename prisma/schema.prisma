generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id      Int    @id @default(autoincrement())
  site_id String @unique @default(uuid())

  fullname String
  email    String  @unique
  username String? @unique

  password String?
  googleId String?

  avatar String?

  status tableStatus @default(active)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects              Project[]        @relation("ProjectOwner")
  collaborations        ProjectMember[]
  sentNotifications     Notification[]   @relation("NotificationFrom")
  receivedNotifications Notification[]   @relation("NotificationTo")
  sentInvites           InviteProjects[] @relation("InviteFrom")
  receivedInvites       InviteProjects[] @relation("InviteTo")
  inviteProjects        InviteProjects[]

  @@index([email])
  @@index([username])
  @@index([createdAt])
  @@map("users")
}

model Project {
  id      Int    @id @default(autoincrement())
  site_id String @unique @default(uuid())

  title       String
  description String?

  visibility ProjectVisibility @default(PRIVATE)
  status     tableStatus       @default(active)

  ownerId Int
  owner   User @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  diagram    String?
  members    ProjectMember[]
  shareLinks ShareLink[]
  invites    InviteProjects[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([title])
  @@index([status])
  @@index([createdAt])
  @@index([ownerId, status, createdAt])
  @@map("projects")
}

model ProjectMember {
  id      Int    @id @default(autoincrement())
  site_id String @unique @default(uuid())

  projectId Int
  userId    Int

  role   ProjectRole @default(VIEWER)
  status tableStatus @default(active)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
  @@index([createdAt])
  @@map("project_members")
}

model ShareLink {
  id      Int    @id @default(autoincrement())
  site_id String @unique @default(uuid())

  token String @unique

  projectId Int
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  role ProjectRole @default(VIEWER)

  expiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([createdAt])
  @@map("share_links")
}

model Notification {
  id         Int    @id @default(autoincrement())
  site_id    String @unique @default(uuid())
  fromUserId Int?
  toUserId   Int?

  title   String
  message String?

  isRead Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fromUser User? @relation("NotificationFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User? @relation("NotificationTo", fields: [toUserId], references: [id], onDelete: Cascade)

  @@index([toUserId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

model Emails {
  id       Int     @id @default(autoincrement())
  site_id  String  @unique
  email_id String
  email    String
  seen     Boolean @default(false)
  click    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([email_id])
  @@index([site_id])
  @@index([id])
}

model InviteProjects {
  id            Int         @id @default(autoincrement())
  inviterName   String?
  snederInvite  Int
  toUserInvetId Int?
  projectId     Int
  email         String?
  firstName     String?
  site_id       String      @unique @default(uuid())
  workspaceName String
  status        tableStatus @default(active)

  snederInviteid User?    @relation("InviteFrom", fields: [snederInvite], references: [id], onDelete: Cascade)
  toUserInvetid  User?    @relation("InviteTo", fields: [toUserInvetId], references: [id], onDelete: Cascade)
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User?    @relation(fields: [userId], references: [id])
  userId         Int?

  @@index([site_id])
  @@index([id])
  @@index([projectId])
  @@index([email])
  @@index([email, status])
}

enum tableStatus {
  active
  inactive
  delete
  ban
}

enum ProjectRole {
  OWNER
  EDITOR
  VIEWER
}

enum ProjectVisibility {
  PRIVATE
  PUBLIC
  UNLISTED
}
